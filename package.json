{
  "name": "session-hub",
  "displayName": "Session Hub",
  "version": "0.8.2",
  "description": "%ext.description%",
  "publisher": "carlosvisbal",
  "author": {
    "name": "Carlos Visbal",
    "email": "carlosvisbal66@gmail.com",
    "url": "https://github.com/carlosvisbal"
  },
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/carlosvisbal/session-hub.git"
  },
  "homepage": "https://github.com/carlosvisbal/session-hub#readme",
  "bugs": {
    "url": "https://github.com/carlosvisbal/session-hub/issues"
  },
  "keywords": [
    "mcp",
    "claude-code",
    "cursor",
    "ai",
    "collaboration",
    "p2p",
    "hyperswarm",
    "team",
    "sessions",
    "backup",
    "messaging",
    "copilot",
    "knowledge-sharing"
  ],
  "categories": [
    "AI",
    "Other"
  ],
  "icon": "media/logo.png",
  "galleryBanner": {
    "color": "#0d1b3e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=22.5"
  },
  "main": "./extension/extension.cjs",
  "type": "module",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "setup": "node src/setup.js",
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "package": "vsce package",
    "licenses": "node scripts/third-party-notices.mjs",
    "test": "node --test test/*.test.js",
    "test:e2e": "node test/e2e/two-hubs.mjs && node test/e2e/relay.mjs && node test/e2e/backup.mjs",
    "test:ext": "node test/panel.mjs && node test/extension/flows.mjs && node test/extension/cursor.mjs && node test/extension/upgrade.mjs",
    "infra": "node --disable-warning=ExperimentalWarning src/infra.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "sessionHub.start",
        "title": "%cmd.start%",
        "category": "Session Hub",
        "icon": "$(play)"
      },
      {
        "command": "sessionHub.stop",
        "title": "%cmd.stop%",
        "category": "Session Hub",
        "icon": "$(debug-stop)"
      },
      {
        "command": "sessionHub.createTeam",
        "title": "%cmd.createTeam%",
        "category": "Session Hub"
      },
      {
        "command": "sessionHub.joinTeam",
        "title": "%cmd.joinTeam%",
        "category": "Session Hub"
      },
      {
        "command": "sessionHub.copyInvite",
        "title": "%cmd.copyInvite%",
        "category": "Session Hub"
      },
      {
        "command": "sessionHub.shareWorkspace",
        "title": "%cmd.shareWorkspace%",
        "category": "Session Hub"
      },
      {
        "command": "sessionHub.unshareProject",
        "title": "%cmd.unshareProject%",
        "category": "Session Hub"
      },
      {
        "command": "sessionHub.refresh",
        "title": "%cmd.refresh%",
        "category": "Session Hub",
        "icon": "$(refresh)"
      },
      {
        "command": "sessionHub.whatChanged",
        "title": "%cmd.whatChanged%",
        "category": "Session Hub",
        "icon": "$(sparkle)"
      },
      {
        "command": "sessionHub.copyClaudeCommand",
        "title": "%cmd.copyClaudeCommand%",
        "category": "Session Hub"
      },
      {
        "command": "sessionHub.openWebViewer",
        "title": "%cmd.openWebViewer%",
        "category": "Session Hub"
      },
      {
        "command": "sessionHub.openSession",
        "title": "%cmd.openSession%",
        "category": "Session Hub"
      },
      {
        "command": "sessionHub.openDashboard",
        "title": "%cmd.openDashboard%",
        "category": "Session Hub",
        "icon": "$(layout)"
      },
      {
        "command": "sessionHub.openSource",
        "title": "%cmd.openSource%",
        "category": "Session Hub"
      },
      {
        "command": "sessionHub.togglePause",
        "title": "%cmd.togglePause%",
        "category": "Session Hub",
        "icon": "$(debug-pause)"
      },
      {
        "command": "sessionHub.editProjectAccess",
        "title": "%cmd.editProjectAccess%",
        "category": "Session Hub"
      },
      {
        "command": "sessionHub.toggleSessionVisibility",
        "title": "%cmd.toggleSessionVisibility%",
        "category": "Session Hub"
      },
      {
        "command": "sessionHub.doctor",
        "title": "%cmd.doctor%",
        "category": "Session Hub",
        "icon": "$(pulse)"
      },
      {
        "command": "sessionHub.leaveTeam",
        "title": "%cmd.leaveTeam%",
        "category": "Session Hub"
      },
      {
        "command": "sessionHub.blockMember",
        "title": "%cmd.blockMember%",
        "category": "Session Hub"
      },
      {
        "command": "sessionHub.revokeMember",
        "title": "%cmd.revokeMember%",
        "category": "Session Hub"
      },
      {
        "command": "sessionHub.copyNetReport",
        "title": "%cmd.copyNetReport%",
        "category": "Session Hub"
      },
      {
        "command": "sessionHub.setLanguage",
        "title": "%cmd.setLanguage%",
        "category": "Session Hub"
      },
      {
        "command": "sessionHub.sendMessage",
        "title": "%cmd.sendMessage%",
        "category": "Session Hub",
        "icon": "$(mail)"
      },
      {
        "command": "sessionHub.replyMessage",
        "title": "%cmd.replyMessage%",
        "category": "Session Hub"
      },
      {
        "command": "sessionHub.handoffMessage",
        "title": "%cmd.handoffMessage%",
        "category": "Session Hub"
      },
      {
        "command": "sessionHub.approveMessage",
        "title": "%cmd.approveMessage%",
        "category": "Session Hub"
      },
      {
        "command": "sessionHub.dismissMessage",
        "title": "%cmd.dismissMessage%",
        "category": "Session Hub"
      },
      {
        "command": "sessionHub.syncBackup",
        "title": "%cmd.syncBackup%",
        "category": "Session Hub"
      },
      {
        "command": "sessionHub.exportAll",
        "title": "%cmd.exportAll%",
        "category": "Session Hub"
      },
      {
        "command": "sessionHub.purgeCopies",
        "title": "%cmd.purgeCopies%",
        "category": "Session Hub"
      },
      {
        "command": "sessionHub.purgeOwnBackup",
        "title": "%cmd.purgeOwnBackup%",
        "category": "Session Hub"
      },
      {
        "command": "sessionHub.removeFromBackup",
        "title": "%cmd.removeFromBackup%",
        "category": "Session Hub"
      },
      {
        "command": "sessionHub.exportSession",
        "title": "%cmd.exportSession%",
        "category": "Session Hub"
      },
      {
        "command": "sessionHub.setBackupOption",
        "title": "%cmd.setBackupOption%",
        "category": "Session Hub"
      },
      {
        "command": "sessionHub.editBackupNumber",
        "title": "%cmd.editBackupNumber%",
        "category": "Session Hub"
      },
      {
        "command": "sessionHub.useSessionInAi",
        "title": "%cmd.useSessionInAi%",
        "category": "Session Hub"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "sessionHub.openSession",
          "when": "false"
        },
        {
          "command": "sessionHub.toggleSessionVisibility",
          "when": "false"
        },
        {
          "command": "sessionHub.blockMember",
          "when": "false"
        },
        {
          "command": "sessionHub.revokeMember",
          "when": "false"
        },
        {
          "command": "sessionHub.replyMessage",
          "when": "false"
        },
        {
          "command": "sessionHub.handoffMessage",
          "when": "false"
        },
        {
          "command": "sessionHub.approveMessage",
          "when": "false"
        },
        {
          "command": "sessionHub.dismissMessage",
          "when": "false"
        },
        {
          "command": "sessionHub.removeFromBackup",
          "when": "false"
        },
        {
          "command": "sessionHub.exportSession",
          "when": "false"
        },
        {
          "command": "sessionHub.setBackupOption",
          "when": "false"
        },
        {
          "command": "sessionHub.editBackupNumber",
          "when": "false"
        },
        {
          "command": "sessionHub.useSessionInAi",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "sessionHub.openDashboard",
          "when": "view == sessionHub.team",
          "group": "navigation@0"
        },
        {
          "command": "sessionHub.whatChanged",
          "when": "view == sessionHub.team",
          "group": "navigation@1"
        },
        {
          "command": "sessionHub.refresh",
          "when": "view == sessionHub.team",
          "group": "navigation@2"
        },
        {
          "command": "sessionHub.shareWorkspace",
          "when": "view == sessionHub.team",
          "group": "1_setup@1"
        },
        {
          "command": "sessionHub.unshareProject",
          "when": "view == sessionHub.team",
          "group": "1_setup@2"
        },
        {
          "command": "sessionHub.createTeam",
          "when": "view == sessionHub.team",
          "group": "2_team@1"
        },
        {
          "command": "sessionHub.joinTeam",
          "when": "view == sessionHub.team",
          "group": "2_team@2"
        },
        {
          "command": "sessionHub.copyInvite",
          "when": "view == sessionHub.team",
          "group": "2_team@3"
        },
        {
          "command": "sessionHub.copyClaudeCommand",
          "when": "view == sessionHub.team",
          "group": "3_tools@1"
        },
        {
          "command": "sessionHub.openWebViewer",
          "when": "view == sessionHub.team",
          "group": "3_tools@2"
        },
        {
          "command": "sessionHub.start",
          "when": "view == sessionHub.team",
          "group": "4_hub@1"
        },
        {
          "command": "sessionHub.stop",
          "when": "view == sessionHub.team",
          "group": "4_hub@2"
        },
        {
          "command": "sessionHub.togglePause",
          "when": "view == sessionHub.team",
          "group": "1_setup@3"
        },
        {
          "command": "sessionHub.editProjectAccess",
          "when": "view == sessionHub.team",
          "group": "1_setup@4"
        },
        {
          "command": "sessionHub.doctor",
          "when": "view == sessionHub.team",
          "group": "3_tools@0"
        },
        {
          "command": "sessionHub.leaveTeam",
          "when": "view == sessionHub.team",
          "group": "2_team@9"
        },
        {
          "command": "sessionHub.sendMessage",
          "when": "view == sessionHub.team",
          "group": "2_team@4"
        }
      ],
      "view/item/context": [
        {
          "command": "sessionHub.whatChanged",
          "when": "view == sessionHub.team && viewItem == member",
          "group": "inline"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sessionHub",
          "title": "Session Hub",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "sessionHub": [
        {
          "id": "sessionHub.team",
          "name": "%view.team%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "sessionHub.team",
        "contents": "%view.welcome%"
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "sessionHub.mcp",
        "label": "Session Hub"
      }
    ],
    "configuration": {
      "title": "Session Hub",
      "properties": {
        "sessionHub.name": {
          "type": "string",
          "default": "",
          "description": "%cfg.name%"
        },
        "sessionHub.role": {
          "type": "string",
          "default": "",
          "description": "%cfg.role%"
        },
        "sessionHub.sharedProjects": {
          "type": "array",
          "default": [],
          "description": "%cfg.sharedProjects%",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "allow": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": [
                  "*"
                ],
                "description": "%cfg.sharedProjects.allow%"
              }
            },
            "required": [
              "path"
            ]
          }
        },
        "sessionHub.port": {
          "type": "number",
          "default": 7420,
          "description": "%cfg.port%"
        },
        "sessionHub.peers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%cfg.peers%"
        },
        "sessionHub.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.autoStart%"
        },
        "sessionHub.notifyUpdates": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.notifyUpdates%"
        },
        "sessionHub.listSince": {
          "type": "string",
          "default": "all",
          "enum": [
            "all",
            "24h",
            "3d",
            "7d",
            "30d"
          ],
          "enumDescriptions": [
            "%cfg.listSince.enum0%",
            "%cfg.listSince.enum1%",
            "%cfg.listSince.enum2%",
            "%cfg.listSince.enum3%",
            "%cfg.listSince.enum4%"
          ],
          "description": "%cfg.listSince%"
        },
        "sessionHub.nodePath": {
          "type": "string",
          "default": "",
          "description": "%cfg.nodePath%"
        },
        "sessionHub.redactExtra": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "%cfg.redactExtra%"
        },
        "sessionHub.notifyReads": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.notifyReads%"
        },
        "sessionHub.paused": {
          "type": "boolean",
          "default": false,
          "description": "%cfg.paused%"
        },
        "sessionHub.excludedSessions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%cfg.excludedSessions%"
        },
        "sessionHub.network": {
          "type": "string",
          "enum": [
            "lan",
            "private",
            "public"
          ],
          "default": "lan",
          "enumDescriptions": [
            "%cfg.network.enum0%",
            "%cfg.network.enum1%",
            "%cfg.network.enum2%"
          ],
          "description": "%cfg.network%"
        },
        "sessionHub.dhtPort": {
          "type": "number",
          "default": 49737,
          "description": "%cfg.dhtPort%"
        },
        "sessionHub.bootstrap": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%cfg.bootstrap%"
        },
        "sessionHub.relay": {
          "type": "string",
          "default": "",
          "description": "%cfg.relay%"
        },
        "sessionHub.language": {
          "type": "string",
          "enum": [
            "auto",
            "es",
            "en"
          ],
          "default": "auto",
          "enumDescriptions": [
            "%cfg.language.enum0%",
            "%cfg.language.enum1%",
            "%cfg.language.enum2%"
          ],
          "description": "%cfg.language%"
        },
        "sessionHub.inboundMessages": {
          "type": "string",
          "enum": [
            "hold",
            "accept",
            "refuse"
          ],
          "default": "hold",
          "enumDescriptions": [
            "%cfg.inboundMessages.enum0%",
            "%cfg.inboundMessages.enum1%",
            "%cfg.inboundMessages.enum2%"
          ],
          "description": "%cfg.inboundMessages%"
        },
        "sessionHub.notifyMessages": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.notifyMessages%"
        },
        "sessionHub.aiChat": {
          "type": "string",
          "enum": [
            "auto",
            "claude",
            "editor",
            "ask",
            "clipboard"
          ],
          "default": "auto",
          "enumDescriptions": [
            "%cfg.aiChat.enum0%",
            "%cfg.aiChat.enum1%",
            "%cfg.aiChat.enum2%",
            "%cfg.aiChat.enum3%",
            "%cfg.aiChat.enum4%"
          ],
          "description": "%cfg.aiChat%"
        },
        "sessionHub.backupOwnSessions": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.backupOwnSessions%"
        },
        "sessionHub.backupRetentionDays": {
          "type": "number",
          "default": 365,
          "minimum": 0,
          "description": "%cfg.backupRetentionDays%"
        },
        "sessionHub.keepTeamCopies": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.keepTeamCopies%"
        },
        "sessionHub.teamCopiesRetentionDays": {
          "type": "number",
          "default": 180,
          "minimum": 0,
          "description": "%cfg.teamCopiesRetentionDays%"
        },
        "sessionHub.allowTeamCopies": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.allowTeamCopies%"
        },
        "sessionHub.backupMaxMB": {
          "type": "number",
          "default": 2048,
          "minimum": 50,
          "description": "%cfg.backupMaxMB%"
        }
      }
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "b4a": "^1.9.0",
    "blind-relay": "^1.6.1",
    "hyperdht": "^6.34.0",
    "hyperswarm": "^4.17.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "acorn": "^8.18.0",
    "jsdom": "^26.1.0"
  }
}
